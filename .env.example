# Neon Serverless PostgreSQL Connection Strings
# Pooled connection string (with -pooler in hostname) for Prisma Client runtime
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct connection string (without -pooler) for Prisma CLI migrations / db push
DIRECT_URL="postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-32-byte-hex-or-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
